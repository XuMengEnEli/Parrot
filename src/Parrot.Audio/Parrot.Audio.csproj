<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Parrot.Audio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 句子→Edge TTS（内置 Sec-MS-GEC 时钟纠偏+403 重试）；单词→有道 dictvoice -->
