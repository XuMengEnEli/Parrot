    <!-- 播放：Win 用 NAudio；mac 走 afplay（进程外播放，不自研跨平台播放器） -->
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parrot.Core\Parrot.Core.csproj" />
  </ItemGroup>

</Project>
