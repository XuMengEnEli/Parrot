<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Parrot.App.ViewModels"
        xmlns:uvm="clr-namespace:Parrot.UI.ViewModels;assembly=Parrot.UI"
        xmlns:uiv="clr-namespace:Parrot.UI.Views;assembly=Parrot.UI"
        x:Class="Parrot.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="鹦鹉 Parrot"
        Icon="/Assets/app-256.png"
        Width="1080" Height="700"
        MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

  <Grid ColumnDefinitions="190,*">
    <DockPanel Grid.Column="0" Margin="0">
      <!-- 品牌头：应用名 + GitHub 入口（常驻左栏顶部，任何页面都醒目） -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,14,10,8">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="🦜" FontSize="18" VerticalAlignment="Center"/>
          <TextBlock Text="鹦鹉" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding OpenGitHubCommand}"
                ToolTip.Tip="在 GitHub 查看项目 / 提 Issue"
                Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand"
                VerticalAlignment="Center">
          <Path Data="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"
                Fill="Gray" Stretch="Uniform" Width="20" Height="20"/>
        </Button>
      </Grid>

      <ListBox ItemsSource="{Binding Pages}"
               SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
               Padding="8,4">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="uvm:PageViewModelBase">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,8">
              <TextBlock Text="{Binding Glyph}" FontSize="16" Width="20" TextAlignment="Center"/>
              <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- 五个页面常驻可视树，切页只改 IsVisible：视图不重建，讲义滚到哪儿、缩放选到哪儿，切回来都还在原地
         （原先是 ContentControl + DataTemplate，每次切页新建视图，滚动位置必然归零） -->
    <Panel Grid.Column="1">
      <uiv:ReaderPage DataContext="{Binding Reader}" IsVisible="{Binding IsSelected}"/>
      <uiv:PomodoroPage DataContext="{Binding Pomodoro}" IsVisible="{Binding IsSelected}"/>
      <uiv:StudyLogPage DataContext="{Binding StudyLog}" IsVisible="{Binding IsSelected}"/>
      <uiv:ExamPage DataContext="{Binding Exam}" IsVisible="{Binding IsSelected}"/>
      <uiv:SettingsPage DataContext="{Binding Settings}" IsVisible="{Binding IsSelected}"/>
    </Panel>
  </Grid>
</Window>
