<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Parrot.UI.ViewModels"
             xmlns:v="clr-namespace:Parrot.UI.Views"
             xmlns:c="clr-namespace:Parrot.UI.Converters"
             xmlns:p="clr-namespace:Parrot.Pdf;assembly=Parrot.Pdf"
             x:Class="Parrot.UI.Views.ReaderPage"
             x:DataType="vm:ReaderPageViewModel">
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- 工具栏：左＝阅读控制卡片（WrapPanel 自适应：窗口变窄自动换行，不再叠罗汉），
         右＝番茄专注迷你卡（与番茄钟页同一实例） -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,12,0" MinHeight="62">
      <Border Classes="card" Padding="12,6">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ImportButton" Content="📥 导入 PDF" Classes="primary" Margin="0,3,10,3"
                  ToolTip.Tip="选择讲义 PDF 加入书架（可多选）"/>
          <ComboBox x:Name="DocBox" MinWidth="220" MaxWidth="320" Margin="0,3,10,3"
                    ItemsSource="{Binding Documents}"
                    SelectedItem="{Binding SelectedDocument}"
                    PlaceholderText="选择讲义…"
                    ToolTip.Tip="最近打开过的讲义会自动列出">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="p:PdfDocumentSource">
                <TextBlock Text="{Binding Title}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Separator Width="1" Height="20" Margin="2,0,10,0" Opacity="0.25"/>
          <TextBlock Text="视图" VerticalAlignment="Center" Opacity="0.75" Margin="0,3,5,3"/>
          <ComboBox SelectedIndex="{Binding ViewModeIndex, Mode=TwoWay}" MinWidth="118" Margin="0,3,10,3"
                    ToolTip.Tip="文本视图＝按原版式重排的文字；原图视图＝位图页面（扫描句尾 🔊 在图上）">
            <ComboBoxItem>文本视图</ComboBoxItem>
            <ComboBoxItem>原图视图</ComboBoxItem>
          </ComboBox>
          <TextBlock Text="字号" VerticalAlignment="Center" Opacity="0.75" Margin="0,3,5,3"
                     IsVisible="{Binding IsTextView}"/>
          <ComboBox SelectedIndex="{Binding TextSizeIndex, Mode=TwoWay}" MinWidth="76" Margin="0,3,10,3"
                    IsVisible="{Binding IsTextView}">
            <ComboBoxItem>13</ComboBoxItem>
            <ComboBoxItem>15</ComboBoxItem>
            <ComboBoxItem>17</ComboBoxItem>
            <ComboBoxItem>20</ComboBoxItem>
          </ComboBox>
          <TextBlock Text="缩放" VerticalAlignment="Center" Opacity="0.75" Margin="0,3,5,3"
                     IsVisible="{Binding !IsTextView}"/>
          <ComboBox x:Name="ZoomBox" SelectedIndex="1" MinWidth="130" Margin="0,3,10,3"
                    IsVisible="{Binding !IsTextView}"
                    ToolTip.Tip="位图渲染分辨率：越高越清晰、越占内存">
            <ComboBoxItem>96 dpi（省内存）</ComboBoxItem>
            <ComboBoxItem>150 dpi（推荐）</ComboBoxItem>
            <ComboBoxItem>200 dpi</ComboBoxItem>
            <ComboBoxItem>288 dpi（清晰）</ComboBoxItem>
          </ComboBox>
          <Separator Width="1" Height="20" Margin="2,0,10,0" Opacity="0.25"
                     IsVisible="{Binding IsExtracting}"/>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,10,3"
                      IsVisible="{Binding IsExtracting}">
            <ProgressBar IsIndeterminate="True" Width="70" Height="6" VerticalAlignment="Center"/>
            <TextBlock Text="正在提取文字并重建版式…" Opacity="0.7"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,10,3"
                      IsVisible="{Binding OcrStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <ProgressBar IsIndeterminate="True" Width="70" Height="6" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding OcrStatus}" Opacity="0.7"/>
          </StackPanel>
          <TextBlock Text="文字提取失败：可在上方切换“原图视图”查看。" Foreground="#C62828"
                     VerticalAlignment="Center" Margin="0,3,10,3"
                     IsVisible="{Binding ExtractFailed}"/>
          <TextBlock Text="{Binding ImportError}" Foreground="#C62828" VerticalAlignment="Center" Margin="0,3,0,3"
                     IsVisible="{Binding ImportError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </WrapPanel>
      </Border>

      <!-- 番茄专注迷你卡：状态点＋剩余时间＋细进度条（纯 Border，竖 ProgressBar 会撑坏头部）＋播放/暂停 -->
      <Border Grid.Column="1" Classes="card" Margin="10,0,0,0" Padding="14,0"
              IsVisible="{Binding Pomodoro, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="7" Height="7" Fill="{Binding Pomodoro.PhaseBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Pomodoro.PhaseText}" FontSize="10" Opacity="0.65" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Pomodoro.RemainingText}" FontSize="17" FontWeight="SemiBold"
                       FontFamily="Consolas,Menlo,monospace" VerticalAlignment="Center"/>
          </StackPanel>
          <Border Width="4" Height="40" CornerRadius="2" Background="#26808080" VerticalAlignment="Center">
            <Border Width="4" CornerRadius="2" Background="{Binding Pomodoro.PhaseBrush}"
                    VerticalAlignment="Bottom"
                    Height="{Binding Pomodoro.Progress, Converter={x:Static c:FractionToPixels.Instance}, ConverterParameter=40}"/>
          </Border>
          <Button Width="34" Height="34" Padding="0" CornerRadius="17" Classes="primary"
                  Command="{Binding Pomodoro.ToggleStartCommand}"
                  Content="{Binding Pomodoro.ToggleGlyph}" FontSize="12"
                  HorizontalContentAlignment="Center" VerticalAlignment="Center"
                  ToolTip.Tip="开始 / 暂停专注（与「番茄钟」页同一计时器）"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 扫描件整册说明（自动切原图时出现） -->
    <Border Grid.Row="1" Margin="12,8,12,0" CornerRadius="10" Padding="12,7"
            Background="#22FF8F00" BorderBrush="#33FF8F00" BorderThickness="1"
            IsVisible="{Binding ScanHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="ℹ️" VerticalAlignment="Top"/>
        <TextBlock Text="{Binding ScanHint}" Foreground="#B26A00" TextWrapping="Wrap" MaxWidth="900"/>
      </StackPanel>
    </Border>

    <Panel Grid.Row="2">
      <!-- 空状态 -->
      <Border Classes="card" MaxWidth="480" Padding="40,32"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              IsVisible="{Binding HasDocument, Converter={x:Static BoolConverters.Not}}">
        <StackPanel Spacing="10">
          <TextBlock Text="📖" FontSize="44" HorizontalAlignment="Center"/>
          <TextBlock Text="导入讲义 PDF，按原版式阅读，每个英文句子带 🔊 发音"
                     FontSize="15" HorizontalAlignment="Center"/>
          <TextBlock Text="扫描件（无文本层）会在后台离线识别，句尾 🔊 直接标注在原图上"
                     FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
          <Button x:Name="ImportButton2" Content="📥 选择 PDF 文件" Classes="primary"
                  HorizontalAlignment="Center" Margin="0,8,0,0" Padding="18,6"/>
        </StackPanel>
      </Border>

      <!-- 文本视图（主视图）：块模板在 App.axaml 全局；ListBox 提供虚拟化（讲义可达数千块） -->
      <ListBox ItemsSource="{Binding Blocks}" FontSize="{Binding TextFontSize}"
               MaxWidth="960" HorizontalAlignment="Center" Padding="24,8,24,32"
               Background="Transparent" BorderThickness="0"
               IsVisible="{Binding IsTextView}">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
              <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"/>
              </ControlTemplate>
            </Setter>
          </ControlTheme>
        </ListBox.ItemContainerTheme>
      </ListBox>

      <!-- 原图视图（兜底：扫描件/公式图/提取失败） -->
      <ListBox x:Name="PageList"
               ItemsSource="{Binding CurrentPages}"
               SelectedItem="{Binding SelectedPage}"
               Padding="16" ScrollViewer.HorizontalScrollBarVisibility="Auto"
               IsVisible="{Binding !IsTextView}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <v:PageHost/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </Grid>
</UserControl>
