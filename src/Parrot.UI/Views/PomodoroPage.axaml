<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Parrot.UI.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:Class="Parrot.UI.Views.PomodoroPage"
             x:DataType="vm:PomodoroPageViewModel">
  <TabControl x:Name="Tabs" Margin="16" SelectionChanged="OnTabChanged">
    <TabItem Header="计时">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="460">
        <TextBlock Text="{Binding PhaseText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding RemainingText}" FontSize="64" FontFamily="Consolas,Menlo,monospace"
                   HorizontalAlignment="Center"/>
        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="10" CornerRadius="5"/>

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="{Binding StartButtonText}"
                  Classes="primary" Command="{Binding ToggleStartCommand}" MinWidth="110"
                  HorizontalContentAlignment="Center"/>
          <Button Content="重置" Command="{Binding ResetCommand}" MinWidth="80"/>
        </StackPanel>

        <TextBlock Text="{Binding DoneHint}" HorizontalAlignment="Center" FontSize="14"
                   Foreground="#2E7D32" MinHeight="20" TextWrapping="Wrap" TextAlignment="Center"/>

        <Border Classes="card" Padding="16,9" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="20" Opacity="0.85">
            <TextBlock VerticalAlignment="Center">
              <Run Text="今日 "/><Run Text="{Binding TodaySessions}" FontWeight="Bold"/><Run Text=" 个番茄"/>
            </TextBlock>
            <Separator Width="1" Height="16" Opacity="0.25"/>
            <TextBlock VerticalAlignment="Center">
              <Run Text="专注 "/><Run Text="{Binding TodayMinutes}" FontWeight="Bold"/><Run Text=" 分钟"/>
            </TextBlock>
            <Separator Width="1" Height="16" Opacity="0.25"/>
            <TextBlock Text="{Binding CompletedFocusTotal, StringFormat='本次会话 {0} 个'}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </TabItem>

    <TabItem Header="统计">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="近 14 天专注（分钟数含未完成片段；番茄数只计完整专注）"
                     VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
          <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshStatsCommand}" MinWidth="72"/>
        </Grid>
        <Border Classes="card" Padding="8">
          <sp:AvaPlot x:Name="StatsPlot" Height="420"/>
        </Border>
      </DockPanel>
    </TabItem>

    <TabItem Header="专注日历">
      <!-- 完成一次番茄钟，当天那格的数字就 +1；底色深浅是"这天坐下来了几次"的热力 -->
      <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Center">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <Button Grid.Column="0" Content="‹" Command="{Binding PrevMonthCommand}" MinWidth="36"
                  ToolTip.Tip="上个月" HorizontalContentAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding CalendarTitle}" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="10,0"/>
          <Button Grid.Column="2" Content="›" Command="{Binding NextMonthCommand}" MinWidth="36"
                  ToolTip.Tip="下个月" HorizontalContentAlignment="Center"/>
          <Button Grid.Column="3" Content="回到本月" Command="{Binding BackToThisMonthCommand}"
                  Margin="10,0,0,0" IsVisible="{Binding IsThisMonth, Converter={x:Static BoolConverters.Not}}"/>
          <TextBlock Grid.Column="5" Text="{Binding CalendarSummary}" FontSize="12" Opacity="0.7"
                     VerticalAlignment="Center"/>
        </Grid>

        <Border Classes="card" Padding="14,10">
          <StackPanel Spacing="6">
            <UniformGrid Columns="7" Margin="0,0,0,2">
              <TextBlock Text="一" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
              <TextBlock Text="二" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
              <TextBlock Text="三" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
              <TextBlock Text="四" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
              <TextBlock Text="五" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
              <TextBlock Text="六" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
              <TextBlock Text="日" FontSize="11" Opacity="0.55" HorizontalAlignment="Center"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding CalendarCells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FocusDayCell">
                  <Border Margin="3" MinHeight="72" CornerRadius="9" Background="{Binding Fill}"
                          BorderBrush="#FFB300" BorderThickness="{Binding Edge}"
                          ToolTip.Tip="{Binding Tip}">
                    <Grid RowDefinitions="Auto,*" Margin="6,3">
                      <TextBlock Grid.Row="0" Text="{Binding DayNumber}" FontSize="10.5" Opacity="0.6"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
                      <TextBlock Grid.Row="1" Text="{Binding CountText}" FontSize="21" FontWeight="Bold"
                                 Foreground="{Binding CountBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
              <TextBlock Text="番茄数" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
              <TextBlock Text="0" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
              <Border Width="16" Height="16" CornerRadius="4" Background="#128C9199"/>
              <Border Width="16" Height="16" CornerRadius="4" Background="#EFFF9A9A"/>
              <TextBlock Text="1" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
              <Border Width="16" Height="16" CornerRadius="4" Background="#FFE57373"/>
              <TextBlock Text="2" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
              <Border Width="16" Height="16" CornerRadius="4" Background="#FFEF5350"/>
              <TextBlock Text="3–4" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
              <Border Width="16" Height="16" CornerRadius="4" Background="#FFE53935"/>
              <TextBlock Text="5+ 个" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
              <Separator Width="10" Opacity="0"/>
              <Border Width="16" Height="16" CornerRadius="4" BorderBrush="#FFB300" BorderThickness="2"/>
              <TextBlock Text="今天" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>
