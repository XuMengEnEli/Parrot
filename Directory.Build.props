<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- 版本号：在线升级的比较基准（App 程序集 Version 前三段展示为 vX.Y.Z） -->
    <Version>1.3.0</Version>
    <!-- 依赖版本集中管理（版本核对于 2026-09-15，升级前先确认 nuget.org 上包名与版本仍在） -->
    <AvaloniaVersion>12.1.2</AvaloniaVersion>
    <SemiVersion>12.1.0.1</SemiVersion>
  </PropertyGroup>

  <!-- 非 Windows 主机也允许编译 windows TFM 工程（Parrot.Ocr.Windows）：
       这样 mac/Linux 克隆下来 dotnet build 整包即通过，WinRT 运行期仍只在 Windows 生效。 -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
